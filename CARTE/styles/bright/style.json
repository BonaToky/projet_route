{
  "version": 8,
  "name": "bright",
  "sources": {
    "antananarivo": {
      "type": "vector",
      "url": "mbtiles://{antananarivo}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f4f0"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "antananarivo",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a0cfdf"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "antananarivo",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#c8e6c9",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "antananarivo",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e0e0e0",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "antananarivo",
      "source-layer": "park",
      "paint": {
        "fill-color": "#a5d6a7",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "antananarivo",
      "source-layer": "building",
      "paint": {
        "fill-color": "#d6d6d6",
        "fill-outline-color": "#bdbdbd"
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "antananarivo",
      "source-layer": "transportation",
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "minor", "service", "track"]],
      "paint": {
        "line-color": "#ffffff",
        "line-width": 1
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "antananarivo",
      "source-layer": "transportation",
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "secondary", "tertiary"]],
      "paint": {
        "line-color": "#fafafa",
        "line-width": 2
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "antananarivo",
      "source-layer": "transportation",
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "primary"]],
      "paint": {
        "line-color": "#ffd54f",
        "line-width": 3
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "antananarivo",
      "source-layer": "transportation",
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "trunk", "motorway"]],
      "paint": {
        "line-color": "#ffb74d",
        "line-width": 4
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "antananarivo",
      "source-layer": "transportation_name",
      "layout": {
        "text-field": "{name}",
        "text-size": 10,
        "symbol-placement": "line",
        "text-font": ["Noto Sans Regular"]
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "antananarivo",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-size": 14,
        "text-font": ["Noto Sans Bold"]
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}
